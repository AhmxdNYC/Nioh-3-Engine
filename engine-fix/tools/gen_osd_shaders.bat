@echo off
rem Compile src\osd.hlsl to DXBC (SM 5.0) and write src\osd_shaders.h. Needs fxc.exe (Windows SDK); the header is
rem checked in, so build.bat does not need this.
setlocal
cd /d "%~dp0.."
where fxc >nul 2>nul || if exist "%~dp0..\..\..\tools\msvc\setup_x64.bat" call "%~dp0..\..\..\tools\msvc\setup_x64.bat"
where fxc >nul 2>nul || (echo ERROR: fxc.exe not found & exit /b 1)
if not exist build mkdir build
fxc /nologo /T vs_5_0 /E vs_main /O3 /Qstrip_reflect /Qstrip_debug /Vn kOsdVS /Fh build\osd_vs.h src\osd.hlsl || exit /b 1
fxc /nologo /T ps_5_0 /E ps_main /O3 /Qstrip_reflect /Qstrip_debug /Vn kOsdPS /Fh build\osd_ps.h src\osd.hlsl || exit /b 1
(
  echo // Generated by tools\gen_osd_shaders.bat from src\osd.hlsl - do not edit.
  echo #pragma once
  type build\osd_vs.h
  type build\osd_ps.h
) > src\osd_shaders.h
echo wrote src\osd_shaders.h
endlocal
