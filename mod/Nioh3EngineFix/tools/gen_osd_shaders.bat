@echo off
setlocal
cd /d "%~dp0.."
where fxc >nul 2>nul || (echo Run from a Windows SDK developer prompt. & exit /b 1)
if not exist build mkdir build
fxc /nologo /Ges /WX /O3 /T vs_5_0 /E vs_main /Vn kOsdVS /Fh build\osd_vs.h src\osd.hlsl || exit /b 1
fxc /nologo /Ges /WX /O3 /T ps_5_0 /E ps_main /Vn kOsdPS /Fh build\osd_ps.h src\osd.hlsl || exit /b 1
>src\osd_shaders.h echo // Generated by tools\gen_osd_shaders.bat from src\osd.hlsl - do not edit.
>>src\osd_shaders.h echo #pragma once
type build\osd_vs.h >>src\osd_shaders.h
type build\osd_ps.h >>src\osd_shaders.h
powershell -NoProfile -Command "$p = (Resolve-Path 'src/osd_shaders.h').Path; $lines = [IO.File]::ReadAllLines($p); [IO.File]::WriteAllLines($p, ($lines | ForEach-Object { $_.TrimEnd() }))"
if errorlevel 1 exit /b 1
