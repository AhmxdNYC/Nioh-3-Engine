// Version resource shared by our mods. CompanyName must equal crashblame::kOurCompany (Nioh3EngineFix/src/crashblame.h):
// the crash report blames a Nioh3*.asi on us only with this CompanyName (or none + one of our shipped names), #94704.
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "nioh3-engine mods"
      VALUE "ProductName", "Nioh 3 engine mods"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
